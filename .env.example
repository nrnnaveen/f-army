# ─────────────────────────────────────────────────────────────
# FARMY — Environment variables
#
# You do NOT need to fill in anything here to deploy FARMY.
# With nothing configured, the app deploys and runs fully in
# "Demo Mode" using its built-in sample data (crops, pests, weather,
# a local recommendation engine, etc). Add the sections below one at a
# time, whenever you want that specific feature to go "live".
# ─────────────────────────────────────────────────────────────

# Optional. Only needed for local `vercel dev` CORS testing against a
# separately-hosted frontend. Leave blank when frontend + API are the
# same Vercel deployment (the default setup).
FRONTEND_URL=

# ── Supabase (required for: login/OTP, crop database, farms, soil/yield/
#    profit history, and to fully power the AI assistant) ─────
# Create a free project at https://supabase.com, then run
# supabase/schema.sql in its SQL editor. Get these three values from
# Project Settings → API.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Weather (OpenWeatherMap — free tier covers current + 5-day forecast) ─
# Get a free key at https://openweathermap.org/api
OPENWEATHER_API_KEY=

# ── AI Assistant (Farmy Assistant chat) ────────────────────────
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# ── Optional: custom SMS/email gateway ─────────────────────────
# Only needed if you manage OTP delivery yourself instead of using
# Supabase's built-in Phone/Email providers (see README §2).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
RESEND_API_KEY=
EMAIL_FROM=FARMY <login@yourdomain.com>
